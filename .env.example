LISTEN_HOST=127.0.0.1
LISTEN_PORT=8787

# `static` uses the values below. `ccswitch` reads the active provider from
# Claude's settings file before each request, so CCSwitch provider changes are
# picked up without restarting the proxy.
UPSTREAM_SOURCE=static
CCSWITCH_SETTINGS_PATH=~/.claude/settings.json

# When enabled, startup redirects Claude Code through this proxy and a clean
# SIGINT/SIGTERM restores the exact settings file bytes from before startup.
CLAUDE_SETTINGS_AUTO=false
CLAUDE_SETTINGS_PATH=~/.claude/settings.json
CLAUDE_PROXY_URL=http://127.0.0.1:8787
CLAUDE_PROXY_API_KEY=proxy-local-token

# When enabled, startup adds a temporary Codex model provider that targets the
# `/codex` route. The original provider URL and authentication remain separate,
# and shutdown restores config.toml byte-for-byte.
CODEX_SETTINGS_AUTO=false
CODEX_CONFIG_PATH=~/.codex/config.toml
CODEX_PROXY_URL=http://127.0.0.1:8787/codex
CODEX_PROXY_API_KEY=proxy-local-token
# Optional when the active custom provider has base_url; otherwise OpenAI's /v1
# endpoint is used. Set this for a built-in or profile-specific custom provider.
# CODEX_UPSTREAM_URL=https://api.openai.com/v1

# Fallback upstream values. Keep these valid when UPSTREAM_SOURCE=ccswitch.
UPSTREAM_URL=https://api.anthropic.com
UPSTREAM_API_KEY=
# anthropic, bearer, or preserve
UPSTREAM_AUTH_MODE=anthropic

# Clients can send this key to the proxy. The proxy key is never
# forwarded when it matches the incoming credential.
PROXY_API_KEY=proxy-local-token
# Set to true to skip proxy authentication checks and preserve client's original
# API key. In passthrough mode, clients only need to change Base URL, not the key.
# The proxy still performs sanitization, review, and audit.
PROXY_AUTH_PASSTHROUGH=false
PROXY_ADMIN_TOKEN=admin

# 审查总开关（默认 llm = 开启）
#   llm = 本地硬拦 + LLM 一审/二审
#   off = 关闭整段审查（本地硬拦与 LLM 都不跑）；脱敏与审计仍会做，请求直接转发
REVIEW_MODE=llm
# all = 审查非管理类路径；api = 仅审查 /v1/messages 等 API 列表
REVIEW_SCOPE=all
# anthropic | openai-responses | openai-chat | codex
REVIEW_PROVIDER=anthropic
REVIEW_BASE_URL=https://api.anthropic.com
REVIEW_API_KEY=
REVIEW_MODEL=claude-haiku-4-5-20251001
REVIEW_TIMEOUT_MS=8000
REVIEW_MAX_OUTPUT_TOKENS=512
# 送审投影的最大字符/消息数（不影响实际上行原文）
REVIEW_MAX_INPUT_CHARS=24000
REVIEW_MAX_MESSAGES=12
# 审查并发与排队
REVIEW_MAX_CONCURRENT=2
REVIEW_MIN_INTERVAL_MS=100
REVIEW_QUEUE_SIZE=32
REVIEW_QUEUE_BYTES=67108864
REVIEW_MAX_RETRIES=2
REVIEW_RETRY_BASE_MS=250
# 审查故障策略（与 REVIEW_MODE 无关）
#   false = 模型超时/挂掉/无法识别时拦截（推荐，默认）
#   true  = 同上故障时放行（仅排障临时用；启动会打警告）
REVIEW_FAIL_OPEN=false
# Optional system prompt and Codex account id.
# REVIEW_PROMPT=
# REVIEW_ACCOUNT_ID=

# Legacy aliases remain supported when the corresponding REVIEW_* value is absent:
# JUDGE_ENABLED=true
# JUDGE_SCOPE=api
# JUDGE_PROVIDER=anthropic
# JUDGE_BASE_URL=https://api.anthropic.com
# JUDGE_API_KEY=
# JUDGE_MODEL=claude-haiku-4-5-20251001
# JUDGE_TIMEOUT_MS=8000
# JUDGE_MAX_OUTPUT_TOKENS=512
# JUDGE_MAX_CONCURRENT=2
# JUDGE_MIN_INTERVAL_MS=100
# JUDGE_QUEUE_SIZE=32
# JUDGE_QUEUE_BYTES=67108864
# JUDGE_MAX_RETRIES=2
# JUDGE_RETRY_BASE_MS=250
# JUDGE_FAIL_OPEN=false
# JUDGE_PROMPT=
# JUDGE_ACCOUNT_ID=
# HTTP/1.1: return an empty 403 and close the client connection on BLOCK.
# HTTP/2: the 403 remains the authoritative rejection signal.
DISCONNECT_ON_BLOCK=false

AUDIT_PATH=./data/zero-domain.audit.jsonl
# off | blocked | all — 管理台要看拦截原文请用 blocked 或 all
AUDIT_INCLUDE_BODY=blocked
# off | blocked | all — blocked 仅向终端打印拦截记录
AUDIT_STDOUT=blocked
# Web console changes are persisted here and loaded on the next startup.
ADMIN_CONFIG_PATH=./data/zero-domain.config.json
